# Required in production (Vercel): a Postgres URL (Neon/Supabase) and a long random secret.
DATABASE_URL=
SESSION_SECRET=
# Optional: comma-separated institution email domains. Empty = any valid email (set this before launch).
ALLOWED_EMAIL_DOMAINS=
# Prototype only: lets students self-verify without a real ID check.
# true = show the email-confirm link on screen and enable the simulated ID check (demos only; no email is sent)
DEMO_VERIFICATION=true
ADMIN_EMAILS=

# --- Real email + verification (turn DEMO_VERIFICATION off when these are set) ---
# Any SMTP provider. Gmail example: smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
EMAIL_FROM=House Odyssey <you@example.com>
# Public site address used inside emails, e.g. https://house-odyssey.vercel.app
APP_URL=
# Confirmed mailboxes on these domains are verified automatically; everyone else is approved by an admin.
AUTO_VERIFY_DOMAINS=
